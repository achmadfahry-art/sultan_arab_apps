# Konfigurasi Lingkungan SULTAN ARAB APP
# Salin ke .env untuk penggunaan lokal

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Untuk cluster lokal mandiri (default port 5433 atau 5432):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sultan_arab_app

# Path Direktori Penyimpanan Privat (di luar public web)
UPLOAD_ROOT=./storage

# Keamanan Sesi & Kredensial
SESSION_SECRET=sultan_arab_secret_key_change_in_production_2026
SESSION_MAX_AGE_MS=86400000

# CORS / Origin yang diizinkan (jika frontend di-host terpisah)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
